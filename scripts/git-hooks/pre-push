#!/bin/sh
# 이 저장소는 GitHub hamudo271/project12 로만 올라가고, 거기서 Railway(heroic-patience) 가 자동 배포한다.
# 다른 계정·다른 저장소로 밀려 다른 곳에 배포되는 일을 막는다. 끄려면 git config core.hooksPath 를 지운다.
ALLOWED_REPO="github.com/hamudo271/project12"
ALLOWED_ACCOUNT="hamudo271"
remote_url="$2"
case "$remote_url" in
  https://github.com/hamudo271/project12|https://github.com/hamudo271/project12.git|git@github.com:hamudo271/project12|git@github.com:hamudo271/project12.git) ;;
  *)
    echo "[배포 보호] 허용된 저장소가 아닙니다: $remote_url" >&2
    echo "[배포 보호] 이 프로젝트는 $ALLOWED_REPO 로만 push 합니다." >&2
    exit 1 ;;
esac
if command -v gh >/dev/null 2>&1; then
  account=$(gh api user --jq .login 2>/dev/null)
  if [ -n "$account" ] && [ "$account" != "$ALLOWED_ACCOUNT" ]; then
    echo "[배포 보호] 지금 로그인된 GitHub 계정이 '$account' 입니다. 이 프로젝트는 '$ALLOWED_ACCOUNT' 로만 push 합니다." >&2
    echo "[배포 보호] gh auth switch --user $ALLOWED_ACCOUNT 로 바꾼 뒤 다시 push 하세요." >&2
    exit 1
  fi
fi
exit 0
